{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clinch",
  "version": "0.1.0",
  "identifier": "com.clinch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Clinch", "width": 1200, "height": 800, "minWidth": 760, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; frame-src 'none'" }
  },
  "bundle": { "active": false }
}
